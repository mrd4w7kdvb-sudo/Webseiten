# Hochgeladene Dateien niemals als Programm ausführen
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php5 .php7 .php8 .phar
RemoveType .php .phtml .php5 .php7 .php8 .phar
<FilesMatch "\.(php|phtml|phar|php\d)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
