# Domain des Servers (DNS-A-Record muss auf die Cloud-VM zeigen)
GW_DOMAIN=monitor.example.de

# Erster Administrator (nur beim allerersten Start verwendet)
GW_ADMIN_USER=admin
GW_ADMIN_PASSWORD=bitte-ein-langes-passwort-setzen

# Speicherfristen in Tagen
GW_METRIC_RETENTION_DAYS=30
GW_LOG_RETENTION_DAYS=14
GW_ALERT_RETENTION_DAYS=180

# Tägliche Datenbanksicherung im Datenvolume (Anzahl, 0 = aus).
# Zusätzlich extern sichern, siehe docs/BETRIEB.md
GW_BACKUP_KEEP=7

# Lebenszeichen des Servers an einen externen Wächter, der alarmiert, wenn es
# ausbleibt (z.B. healthchecks.io-Ping-URL oder Uptime-Kuma-Push-URL).
# Empfohlen – sonst fällt ein Ausfall des Monitorings selbst nicht auf.
GW_HEARTBEAT_URL=
