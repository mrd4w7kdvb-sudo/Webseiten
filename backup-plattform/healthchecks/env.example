# Kopieren nach healthchecks/.env und anpassen

HC_DOMAIN=hc.example.de
SITE_ROOT=https://hc.example.de
SITE_NAME=Backup-Überwachung
ALLOWED_HOSTS=hc.example.de

# Langer Zufallswert, z. B.: openssl rand -base64 48
SECRET_KEY=HIER_ZUFALLSWERT

# E-Mail-Versand für Alarme (SMTP deines Mailanbieters)
DEFAULT_FROM_EMAIL=backup-alarm@example.de
EMAIL_HOST=smtp.example.de
EMAIL_PORT=587
EMAIL_HOST_USER=backup-alarm@example.de
EMAIL_HOST_PASSWORD=HIER_PASSWORT
EMAIL_USE_TLS=True

# Optional: Telegram- oder Signal-Benachrichtigungen, siehe Healthchecks-Doku
# TELEGRAM_BOT_NAME=
# TELEGRAM_TOKEN=
