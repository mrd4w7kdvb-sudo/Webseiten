# Kopieren nach server/.env und anpassen.  Wird von docker compose und den Skripten gelesen.

# Öffentlicher Name des Backup-Servers (DNS-A-Eintrag muss auf den Server zeigen)
DOMAIN=backup.example.de

# Adresse des Servers im WireGuard-Netz (Wartungszugang)
WG_IP=10.8.0.1

# Versionen (vor Einsatz auf aktuellen Stand prüfen)
REST_SERVER_VERSION=0.13.0
CADDY_VERSION=2

# Offsite-Kopie: rclone-Ziel "<remote>:<bucket>"  (remote in /root/.config/rclone/rclone.conf)
RCLONE_ZIEL=ionos:kunden-backup-offsite

# Ping-URLs aus Healthchecks (leer lassen = keine Meldung)
HC_OFFSITE=
HC_SERVER=
