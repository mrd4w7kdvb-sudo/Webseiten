# Kopieren nach wartung/config.env und anpassen.
# Dieser Ordner (wartung/) gehört auf deinen Wartungsrechner, idealerweise auf ein verschlüsseltes Laufwerk.

# SSH-Ziel des Backup-Servers (über WireGuard), z. B. Alias aus ~/.ssh/config
SERVER_SSH="root@10.8.0.1"

# Passwortdatei für Agenten-Zugänge auf dem Server
SERVER_HTPASSWD="/srv/backup/data/.htpasswd"

# Wartungszugang (rest-admin, nur über WireGuard erreichbar)
ADMIN_URL="http://10.8.0.1:8001"
ADMIN_USER="wartung"
# Passwort steht in geheim/admin-rest.pass (Ausgabe von setup-server.sh)

# Öffentliche Adresse, die die Agenten verwenden
PUBLIC_URL="https://backup.example.de"

# Healthchecks (selbst gehostet). Mit API-Schlüssel (Projekt-Einstellungen → API Access,
# Schreibrechte) legen die Skripte die Prüfungen automatisch an.
HC_URL="https://hc.example.de"
HC_API_KEY=""

# Ping-URL für die wöchentliche Wartung (wird bei HC_API_KEY automatisch angelegt, wenn leer)
HC_WARTUNG=""

# Standard-Ordner für die Datenklassen beim Klienten (Windows-Pfad)
DATEN_BASIS='C:\Daten'
